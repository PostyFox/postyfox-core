<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PostyFox.Domain\PostyFox.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="aneillans.adapters-secrets.Core" Version="1.2.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- User-facing API messages (issue #33): generates the strongly typed Resources.Messages class. -->
    <EmbeddedResource Update="Resources\Messages.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Messages.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PostyFox.Application.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Messages</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
