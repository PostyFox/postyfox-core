    "fastify": "^5.12.7",
    "fluent-ffmpeg": "^2.1.3",
    "megalodon": "^10.3.1",
    "node-html-parser": "^9.0.5",
    "oauth-1.0a": "^2.2.6",
    "rettiwt-api": "^7.1.5",
    "sharp": "^0.35.5",
    "tough-cookie": "^6.0.2",
    "tumblr.js": "^5.0.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
