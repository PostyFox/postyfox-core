<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="PostyFox.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PostyFox.Application\PostyFox.Application.csproj" />
    <ProjectReference Include="..\PostyFox.Domain\PostyFox.Domain.csproj" />
  </ItemGroup>

  <!-- Config schemas too large to stay readable as C# string literals (see Persistence/Schemas). -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Schemas\*.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="aneillans.adapters-secrets.Core" Version="1.2.31" />
    <PackageReference Include="aneillans.adapters-secrets.AzureKeyVault" Version="1.2.31" />
    <PackageReference Include="aneillans.adapters-secrets.BitWarden" Version="1.2.31" />
    <PackageReference Include="aneillans.adapters-secrets.HashiCorpVault" Version="1.2.31" />
    <PackageReference Include="aneillans.adapters-secrets.Infisical" Version="1.2.31" />
    <PackageReference Include="aneillans.adapters-secrets.InMemory" Version="1.2.31" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="FFMpegCore" Version="5.5.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
