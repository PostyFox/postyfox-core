{
  "manifest_version": 3,
  "name": "PostyFox Connect",
  "version": "0.3.0",
  "description": "Hands your logged-in website sessions to PostyFox in one click.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://app.postyfox.com/*",
    "https://dev.postyfox.com/*",
    "https://www.furaffinity.net/*",
    "https://furaffinity.net/*",
    "https://toyhou.se/*",
    "https://www.toyhou.se/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://ko-fi.com/*",
    "https://www.ko-fi.com/*"
  ],
  "action": {
    "default_title": "PostyFox Connect",
    "default_popup": "popup.html"
  }
}
