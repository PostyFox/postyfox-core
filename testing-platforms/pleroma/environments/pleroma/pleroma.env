# Consumed by config/docker.exs (baked into the image — see ../../fetch-source.sh) on first boot.
# Variable names match the upstream https://git.pleroma.social/pleroma/pleroma-docker-compose
# example, except PORT: upstream's docker.exs never actually reads it (dead config there — the
# generated URL's port is hardcoded to 443 alongside a hardcoded https scheme); our fetch-source.sh
# patch makes PORT the source of truth for the externally-visible port instead, since DOMAIN here is
# bare host only, not host:port.
DB_USER=pleroma
DB_PASS=pleroma-test-pw
DB_HOST=pleroma-db
DB_NAME=pleroma
INSTANCE_NAME=PostyFox Test Pleroma
ADMIN_EMAIL=admin@postyfox.test
NOTIFY_EMAIL=admin@postyfox.test
DOMAIN=localhost
PORT=4010

# Fixed test admin account, read by admin-init (docker-compose.yml). Not a Pleroma-native var.
ADMIN_NICKNAME=postyfox
ADMIN_PASSWORD=postyfox-test-1234
