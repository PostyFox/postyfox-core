# Test-only config for the local GoToSocial stack — see testing-platform/README.md.

GTS_HOST=localhost:4080
GTS_ACCOUNT_DOMAIN=localhost:4080
GTS_DB_TYPE=sqlite
GTS_DB_ADDRESS=/gotosocial/storage/sqlite.db
GTS_STORAGE_BACKEND=local
GTS_STORAGE_LOCAL_BASE_PATH=/gotosocial/storage
GTS_BIND_ADDRESS=0.0.0.0
GTS_PORT=8080
GTS_PROTOCOL=http

# Closed federation: allow-list mode with nothing allow-listed.
GTS_INSTANCE_FEDERATION_MODE=allowlist

# No self-registration (so no confirmation e-mail flow to disable/skip): the test account is
# created directly by admin-init. No SMTP_* vars are set either, so there's no mail transport
# configured at all — combined with this stack having no route to the real internet (see the
# `net: internal: true` network in docker-compose.yml), nothing can be sent regardless.
GTS_ACCOUNTS_REGISTRATION_OPEN=false
GTS_ACCOUNTS_APPROVAL_REQUIRED=false

GTS_LETSENCRYPT_ENABLED=false
GTS_OIDC_ENABLED=false
GTS_TRUSTED_PROXIES=127.0.0.1/32

# Host port (change if 8080 is taken)
WEB_PORT=4080
