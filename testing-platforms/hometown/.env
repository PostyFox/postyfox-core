# Test-only config for the local Hometown stack. These secrets are fake and committed on purpose —
# see testing-platform/README.md. To regenerate: `openssl rand -hex 64` for SECRET_KEY_BASE/
# OTP_SECRET, `openssl rand -hex 32` for the three ACTIVE_RECORD_ENCRYPTION_* keys, and
# `docker compose run --rm web bin/rails mastodon:webpush:generate_vapid_key` for the VAPID pair.

# --- Federation identity ---
# Includes the port on purpose: this instance is only ever reached at localhost:3001, never proxied
# behind a bare domain, so LOCAL_DOMAIN has to carry the port for links/OAuth redirects to resolve.
LOCAL_DOMAIN=localhost:3001
WEB_DOMAIN=localhost:3001
# Generated URLs (streaming, media, mailer links) use this scheme — see the 1_hosts.rb patch in
# fetch-source.sh for why this needs a source patch to actually take effect under RAILS_ENV=production.
LOCAL_HTTPS=false

# Rails' ActionDispatch::HostAuthorization (config.hosts, set from LOCAL_DOMAIN/WEB_DOMAIN above)
# 403s any request whose Host header isn't recognized — so PostyFox itself, reaching this stack from
# its own dockerized dev network as host.containers.internal:3001 (Podman) / host.docker.internal:3001
# (Docker), gets rejected unless those are allow-listed here too. See
# ../README.md#connecting-from-a-dockerized-postyfox-dev-stack.
ALTERNATE_DOMAINS=host.containers.internal:3001,host.docker.internal:3001

# Closed federation: only instances explicitly domain-allowed can interact with this one, and none
# are allowed. Also disables the public timeline/profile pages and some unauthenticated REST APIs.
# Hometown inherits this from Mastodon unchanged.
LIMITED_FEDERATION_MODE=true

# --- Host ports (distinct from the Mastodon stack's 3000/4000 so both can run at once) ---
WEB_PORT=3001
STREAMING_PORT=4001

# --- Redis / Postgres ---
REDIS_HOST=redis
REDIS_PORT=6379
DB_HOST=db
DB_USER=postgres
DB_NAME=mastodon_production
DB_PASS=
DB_PORT=5432

# --- Secrets (test-only, fixed — see header) ---
SECRET_KEY_BASE=b3a3b56e55667b5691280db41b4cc0328f30d0ba972698002fdddeb46bb1d1da9fc0b0592ad1f4ed0513b404d585a8f98f7a4aa7d3347d0814526cacd2f40454
OTP_SECRET=d2a9527c056b1bfaf09fe7df7afd72064c70774ed30aa94b9b4f01f3fe44bfb1a4d49af0126cc06bdd24b49a808e6bf400f443623f0cea8c9f567802f57c0491
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=6b02b53f21890142ac4a96aae04d424ba496d3618242cc660a7be997b23f1400
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=a516d84682b38aa5e7e93e004e875cb52dd71c690983f8e4ae241dcd32ea68c3
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=4f3c80c449ec4f8723f97089fc8a20bcdebcb960a4d7fa91fdc288c6563f5f54
VAPID_PRIVATE_KEY=UA8C8XbMVZ6vcJbAL6TQ5XufDqFcolxDM6JpoedMxdI
VAPID_PUBLIC_KEY=BPKgiOEE2zrccOkFe8m4kNVzO26eNy17MWRmd3Zn9kWcTFC5h6KVKtaAgtp9_imr9JuvOkbM-p6w7bWpH_xVTVQ

# --- Mail: intentionally left unset ---
# There's no single "disable mail" switch in Mastodon/Hometown. Instead, the admin-init container
# creates the test account already confirmed (see docker-compose.yml), so the registration-
# confirmation email is never triggered. With SMTP_SERVER unset, any other transactional mail just
# fails quietly in Sidekiq — nothing leaves the host because this stack has no route to the internet
# (see the `net: internal: true` network).
SMTP_SERVER=

# admin-init's email (admin@postyfox.test) would otherwise fail Mastodon's signup email validator,
# which does a live DNS MX lookup and rejects anything unresolvable ("unreachable") — there's no
# route to the internet here anyway (see above), so postyfox.test could never resolve. Allow-listing
# it skips that check.
EMAIL_DOMAIN_ALLOWLIST=postyfox.test

# --- Storage: local disk (no S3) ---
S3_ENABLED=false

# --- Fixed test admin account (used by admin-init; see README.md) ---
ADMIN_USERNAME=postyfox
ADMIN_EMAIL=admin@postyfox.test
ADMIN_PASSWORD=postyfox-test-1234

RAILS_ENV=production
NODE_ENV=production
