# Test-only config for the local Mastodon stack. These secrets are fake and committed on purpose —
# see testing-platform/README.md. To regenerate: `openssl rand -hex 64` for SECRET_KEY_BASE/
# OTP_SECRET, `openssl rand -hex 32` for the three ACTIVE_RECORD_ENCRYPTION_* keys, and
# `docker compose run --rm web bin/rails mastodon:webpush:generate_vapid_key` for the VAPID pair.

# --- Federation identity ---
# Includes the port on purpose: this instance is only ever reached at localhost:3000, never proxied
# behind a bare domain, so LOCAL_DOMAIN has to carry the port for links/OAuth redirects to resolve.
LOCAL_DOMAIN=localhost:3000
WEB_DOMAIN=localhost:3000

# force_ssl/use_https are actually overridden via ./local-overrides/zz_postyfox_local_http.rb (a
# bind-mounted Rails initializer — see docker-compose.yml and that file for why: this stack uses
# upstream's prebuilt image, so there's no source tree here to sed the way the hometown stack does).
# This fixes the one piece an initializer running after 1_hosts.rb can't retroactively change — the
# streaming URL, computed once from the https flag when 1_hosts.rb itself runs — and points it at
# the real streaming container's published port rather than the (unreachable, in this no-reverse-
# proxy stack) web port that 1_hosts.rb would otherwise compute.
STREAMING_API_BASE_URL=ws://localhost:4000

# Rails' ActionDispatch::HostAuthorization 403s any request whose Host header isn't LOCAL_DOMAIN/
# WEB_DOMAIN — so PostyFox itself, reaching this stack from its own dockerized dev network as
# host.containers.internal:3000 (Podman) / host.docker.internal:3000 (Docker), needs allow-listing
# too. See ../README.md#connecting-from-a-dockerized-postyfox-dev-stack.
ALTERNATE_DOMAINS=host.containers.internal:3000,host.docker.internal:3000

# Closed federation: only instances explicitly domain-allowed can interact with this one, and none
# are allowed. Also disables the public timeline/profile pages and some unauthenticated REST APIs.
LIMITED_FEDERATION_MODE=true

# --- Host ports (change if 3000/4000 are taken; keep in sync with LOCAL_DOMAIN above if you do) ---
WEB_PORT=3000
STREAMING_PORT=4000

# --- Redis / Postgres ---
REDIS_HOST=redis
REDIS_PORT=6379
DB_HOST=db
DB_USER=postgres
DB_NAME=mastodon_production
DB_PASS=
DB_PORT=5432

# --- Secrets (test-only, fixed — see header) ---
SECRET_KEY_BASE=79fe8248b6335c1438d3a1d460864fab9324609046a1109d64507bbde2c400c844ed13b9b245765ef744657c235ed70d8d3422bc3e6963b4a9f477dd6821d8dd
OTP_SECRET=233c654d778991f0a6f692a0a21c905445619f1d62d86dd8a3e620d17ff550d5625fb13e376cdfd36fd1abb93db5a02bfbcbbe3917180bff0e35bebe7f10ea95
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=ab9cf057aefc1b81de56ffac404cf16f8003d18d7c68bd37bcdec5c91785227b
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=3531b1e2c12e269f316599284c5b6749540550ea0b48b214547ad396c463b4a4
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=e1aa82f0509600a9bec6fb0f4cfe5ab99cd1d4666f039c90d9ead274bd49c85d
VAPID_PRIVATE_KEY=bPxd8KKKBKHec0KePQfd021cVhMOFEwYleWAZGQnKeg
VAPID_PUBLIC_KEY=BA25EYjWwPd97Pn6n1KzQ4APW29YgEMQQz5BZnEYzl7VBwpjNvJOYKd0SUYsnVe9N3g-TTffWbrNtYh0-TrloUU

# --- Mail: intentionally left unset ---
# There's no single "disable mail" switch in Mastodon. Instead, the admin-init container creates
# the test account already confirmed (see docker-compose.yml), so the registration-confirmation
# email is never triggered. With SMTP_SERVER unset, any other transactional mail Mastodon tries to
# send just fails in the background (Sidekiq retries, logs, gives up) — nothing leaves the host
# because this stack has no route to the internet (see the `net: internal: true` network).
SMTP_SERVER=

# admin-init's email (admin@postyfox.test) would otherwise fail Mastodon's signup email validator,
# which does a live DNS MX lookup and rejects anything unresolvable ("unreachable") — there's no
# route to the internet here anyway (see above), so postyfox.test could never resolve. Allow-listing
# it skips that check.
EMAIL_DOMAIN_ALLOWLIST=postyfox.test

# --- Storage: local disk (no S3) ---
S3_ENABLED=false

# --- Fixed test admin account (used by admin-init; see README.md) ---
ADMIN_USERNAME=postyfox
ADMIN_EMAIL=admin@postyfox.test
ADMIN_PASSWORD=postyfox-test-1234

RAILS_ENV=production
NODE_ENV=production
